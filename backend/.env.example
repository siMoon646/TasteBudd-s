# Copy to backend/.env and fill in. Never commit backend/.env.

# Supabase Auth (Supabase dashboard → Project Settings → API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Database (Supabase dashboard → Connect)
# Transaction pooler (port 6543). Used by Prisma Client at runtime.
DATABASE_URL=
# Session pooler (port 5432). Used by the Prisma CLI for migrations (see prisma.config.ts).
DIRECT_URL=
